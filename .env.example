# Runtime
NODE_ENV=development
PORT=4000

# Database (PostgreSQL 17)
DATABASE_URL=postgresql://user:password@localhost:5432/sagelit

# Redis (cache, rate limit, session)
REDIS_URL=redis://localhost:6379

# Auth (Firebase Admin)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Object storage (Cloudflare R2 — S3 compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sagelit-assets
R2_PUBLIC_URL=

# AI providers
REPLICATE_API_TOKEN=
FAL_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Project Gutenberg
GUTENBERG_BASE_URL=https://www.gutenberg.org
